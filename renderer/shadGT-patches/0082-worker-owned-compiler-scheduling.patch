diff --git a/src/video_core/renderer_vulkan/compiler_worker_budget.h b/src/video_core/renderer_vulkan/compiler_worker_budget.h
new file mode 100644
index 0000000..cc6149d
--- /dev/null
+++ b/src/video_core/renderer_vulkan/compiler_worker_budget.h
@@ -0,0 +1,15 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <algorithm>
+namespace Vulkan {
+struct CompilerWorkerBudget {
+    unsigned translation;
+    unsigned pipeline;
+    static constexpr CompilerWorkerBudget ForLogicalThreads(unsigned logical) {
+        // Unknown topology and tiny CPUs use one compiler, without unsigned underflow.
+        const unsigned total = logical > 2 ? logical - 2 : 1;
+        const unsigned translation = total > 1 ? std::max(1u, total / 4) : 0;
+        return {translation, total - translation};
+    }
+};
+} // namespace Vulkan
diff --git a/src/video_core/renderer_vulkan/translation_job_match.h b/src/video_core/renderer_vulkan/translation_job_match.h
new file mode 100644
index 0000000..cb8ac67
--- /dev/null
+++ b/src/video_core/renderer_vulkan/translation_job_match.h
@@ -0,0 +1,13 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+namespace Vulkan {
+// A shared shader hash is not enough to identify the compilation this command
+// depends on. Other stages/runtime permutations can still be queued independently.
+template <class Job, class HwStage, class SwStage, class Runtime, class Bindings>
+bool MatchesTranslationRequest(const Job& job, HwStage hw_stage, SwStage sw_stage,
+                               const Runtime& runtime_info, const Bindings& start) {
+    return job.hw_stage == hw_stage && job.sw_stage == sw_stage &&
+           job.runtime_info == runtime_info && job.start == start;
+}
+}
