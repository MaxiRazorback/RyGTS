* text=auto eol=lf
# cmd.exe needs CRLF for ^ line continuations.
*.cmd text eol=crlf
*.bat text eol=crlf
*.png binary
*.jpg binary
*.ico binary
*.AppImage binary
*.zip binary
*.bin binary
*.spv binary
*.prx binary
*.elf binary
*.dll binary
*.exe binary

# Diagnostic overlay hashes and patches are identical on Windows and Linux.
ci/diagnostics/*.py text eol=lf
ci/diagnostics/*.json text eol=lf
# Unified diff context has a required leading space, including empty lines.
ci/diagnostics/*.patch text eol=lf whitespace=-blank-at-eol
ci/diagnostics/*.h text eol=lf
